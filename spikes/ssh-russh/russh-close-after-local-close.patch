+/// Channels this side sent CHANNEL_CLOSE for, still waiting for the peer's CHANNEL_CLOSE.
+///
+/// Sending CLOSE releases the channel's parameters, so the peer's answering CLOSE no longer finds an established
+/// channel. Without this record the answer was dropped and `Channel::wait()` never returned after a local close.
+#[derive(Debug, Default)]
+pub(crate) struct LocallyClosed(std::collections::HashSet<ChannelId>);
+
+impl LocallyClosed {
+    pub(crate) fn mark(&mut self, channel: ChannelId) {
+        self.0.insert(channel);
+    }
+
+    /// Whether `channel` was closed locally and its CLOSE not yet answered; the record is consumed, so a second CLOSE
+    /// for the same channel is not taken for an answer
+    pub(crate) fn take(&mut self, channel: ChannelId) -> bool {
+        self.0.remove(&channel)
+    }
