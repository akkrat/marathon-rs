+    /// Account for received data without refilling the window (manual window adjustment).
+    pub fn consume_window_size(&mut self, channel: ChannelId, data: &[u8]) {
+        if let Some(channel) = self.channels.get_mut(&channel) {
+            // Ignore extra data, as adjust_window_size does.
+            if data.len() as u32 <= channel.sender_window_size {
+                channel.sender_window_size -= data.len() as u32;
+            }
+        }
+    }
+
+    /// Send CHANNEL_WINDOW_ADJUST for `bytes`; a channel no longer open is skipped.
+    pub fn grow_window_size(&mut self, channel: ChannelId, bytes: u32) -> Result<(), crate::Error> {
+        if bytes == 0 {
+            return Ok(());
+        }
+        if let Some(channel) = self.channels.get_mut(&channel) {
+            push_packet!(self.write, {
+                self.write.push(msg::CHANNEL_WINDOW_ADJUST);
+                channel.recipient_channel.encode(&mut self.write)?;
+                bytes.encode(&mut self.write)?;
+            });
+            channel.sender_window_size = channel.sender_window_size.saturating_add(bytes);
+        }
+        Ok(())
+    }
