+        let mut total = 0;
+        tokio::time::timeout(std::time::Duration::from_secs(30), async {
+            while total < expected {
+                match channel.wait().await {
+                    Some(crate::ChannelMsg::Data { data }) => total += data.len(),
+                    Some(_) => (),
