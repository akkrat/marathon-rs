{
  "format": "marathon-replay/scenario@1",
  "name": "random sorting with explicit draw and clock reads",
  "source": "oracle replay coverage",
  "tests": [
    {
      "pkg": "test",
      "clazz": "SimpleTest",
      "method": "test",
      "metaProperties": [
        {
          "name": "someAnnotation",
          "values": {
            "value": "contact.foo@deadbeef",
            "duration": "contact.foo@deadbeef"
          }
        }
      ]
    }
  ],
  "devices": [
    {
      "serial": "serial-1",
      "results": {
        "test.SimpleTest#test": [
          "PASSED",
          "PASSED"
        ]
      }
