#!/usr/bin/env python3
"""Writes the strict fake-adb scripts of the x1 reconnect scenarios into fixtures/fake-adb/android-reconnect/script.

All scenarios: 20 remote-discovered tests (com.example.T00..T19, one `am instrument` batch each, 4 s on the device).
`same-server`:        emulator-5554 on one server from the start; emulator-5556 on the same server from 4 s (after
                      the remote parser borrowed a device, so the parser never touches it). Its first `rm -r`, the
                      second step of prepare after the installer, hangs: prepare is in progress when the server drops
                      5556 at 8 s. It is listed again at 12 s.
`same-server-flaky`:  as above, but the first two installs succeed (the first prepare) and the reconnected 5556 then
                      fails `cmd package install` 6 times (two prepare attempts of three installer attempts each)
                      before it succeeds.
`cross-host`:         two servers, each with emulator-5556 only (the adb-serial-only device map, N27). B's is there
                      from the start; A's appears at 2 s, so the provider's map holds A's device when A's 5556 (hung in
                      prepare as above) is dropped at 8 s and listed again at 12 s.
`cross-host-shadowed`: the same, but A's device is there from the start and B's appears at 2 s: the map entry for
                      `emulator-5556` is B's healthy device when A's is dropped.
Timeline events are relative to the start of the fake server; the CLIs start provider and parser within about 3 s.
"""
import json, pathlib
root = pathlib.Path(__file__).resolve().parents[3]
out = root / 'fixtures/fake-adb/android-reconnect/script'
out.mkdir(parents=True, exist_ok=True)
TESTS = 20
DROP_MS, BACK_MS = 8000, 12000
STATUS = ('INSTRUMENTATION_STATUS: class=com.example.T{n:02d}\nINSTRUMENTATION_STATUS: test=test\nINSTRUMENTATION_STATUS: numtests=1\n'
          'INSTRUMENTATION_STATUS_CODE: 1\n'
          'INSTRUMENTATION_STATUS: com.malinskiy.adam.junit4.android.listener.TestAnnotationProducer.v4=[16Lorg.junit.Test()]\n'
          'INSTRUMENTATION_STATUS_CODE: 2\n'
          'INSTRUMENTATION_STATUS: class=com.example.T{n:02d}\nINSTRUMENTATION_STATUS: test=test\nINSTRUMENTATION_STATUS_CODE: 0\n')
discovery = ''.join(STATUS.format(n=n) for n in range(TESTS)) + 'INSTRUMENTATION_CODE: -1\n'


def device(serial, shell=None, connected=True):
    d = {'serial': serial, 'connected': connected, 'features': ['shell_v2', 'cmd', 'abb_exec', 'sendrecv_v2'],
         'getprop': {'sys.boot_completed': '1', 'ro.product.cpu.abi': 'x86', 'ro.build.version.sdk': '33',
                     'ro.build.version.codename': 'REL', 'ro.product.model': 'Android SDK built for x86',
                     'ro.product.manufacturer': 'Google', 'ro.boot.serialno': 'EMULATOR30X6X5X0'}}
    if shell:
        d['shell'] = shell
    return d


def shared():
    rules = [{'exact': 'logcat -c', 'stdout': ''},
             {'exact': 'logcat -v long', 'hang': True},
             {'regex': '^am instrument.* -e log true', 'stdout': discovery}]
    for n in range(TESTS):
        rules.append({'regex': f'^am instrument .* -e class com\\.example\\.T{n:02d}#test ',
                      'delay_ms': 4000, 'stdout': STATUS.format(n=n) + 'INSTRUMENTATION_CODE: -1\n'})
    rules += [{'prefix': 'cmd package install', 'service': 'exec', 'stdout': 'Success\n'},
              {'exact': 'pm list packages', 'stdout': ''},
              {'exact': 'echo $EXTERNAL_STORAGE', 'stdout': '/sdcard\n'},
              {'exact': 'ls /system/bin/screenrecord', 'stdout': '/system/bin/screenrecord\n'},
              {'exact': 'ls /system/bin/md5', 'stdout': '/system/bin/md5\n'},
              {'exact': 'dumpsys input', 'stdout': 'SurfaceOrientation: 0\n'},
              {'prefix': 'rm ', 'stdout': ''}, {'prefix': 'mkdir ', 'stdout': ''},
              {'prefix': 'package install', 'service': 'abb_exec', 'stdout': 'Success\n'}]
    return rules


def script(devices, events):
    return {'server': {'strict': True}, 'devices': devices, 'shell': shared(), 'events': events}


hang = {'prefix': 'rm ', 'times': 1, 'delay_ms': 3600000, 'stdout': ''}
first_prepare_installs = {'prefix': 'package install', 'service': 'abb_exec', 'times': 2, 'stdout': 'Success\n'}
flaky = {'prefix': 'package install', 'service': 'abb_exec', 'times': 6,
         'stdout': 'Failure [INSTALL_FAILED_INSUFFICIENT_STORAGE]\n', 'exit_code': 1}
drop = [{'at_ms': DROP_MS, 'disconnect': 'emulator-5556'}, {'at_ms': BACK_MS, 'connect': 'emulator-5556'}]
late = [{'at_ms': 4000, 'connect': 'emulator-5556'}] + drop
files = {
    'same-server': script([device('emulator-5554'), device('emulator-5556', [hang], connected=False)], late),
    'same-server-flaky': script([device('emulator-5554'), device('emulator-5556', [first_prepare_installs, hang, flaky], connected=False)], late),
    'cross-host-a': script([device('emulator-5556', [hang], connected=False)], [{'at_ms': 2000, 'connect': 'emulator-5556'}] + drop),
    'cross-host-b': script([device('emulator-5556')], []),
    'cross-host-shadowed-a': script([device('emulator-5556', [hang])], drop),
    'cross-host-shadowed-b': script([device('emulator-5556', connected=False)], [{'at_ms': 2000, 'connect': 'emulator-5556'}]),
}
for name, content in files.items():
    (out / f'{name}.json').write_text(json.dumps(content, indent=1) + '\n')
    print('wrote', name)
