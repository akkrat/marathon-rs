#!/usr/bin/env python3
"""Record original listeners first on the existing strict fake. No adb process is used."""
import json, os, pathlib, subprocess, tempfile, time
root=pathlib.Path(__file__).resolve().parents[3]
base=root/'fixtures/fake-adb/android-artifacts'
base.mkdir(exist_ok=True)
for mode in ['video','video-timeout','screenshot','filesync-coverage','perfetto']:
 with tempfile.TemporaryDirectory(prefix='mrs66b-scenario-') as tmp:
  temp=pathlib.Path(tmp);script={'server':{'strict':True},'devices':[{'serial':'emulator-5554','features':[],'getprop':{'sys.boot_completed':'0','ro.product.cpu.abi':'x86','ro.build.version.sdk':'33','ro.build.version.codename':'REL','ro.product.model':'Android SDK built for x86','ro.product.manufacturer':'Google','ro.boot.serialno':'EMULATOR30X6X5X0'}}],'shell':[
   {'exact':'dumpsys input','stdout':'SurfaceOrientation: 0\n'},{'exact':'echo $EXTERNAL_STORAGE','stdout':'/sdcard\r\n'}, {'exact':'ls /system/bin/screenrecord','stdout':'/system/bin/screenrecord'},{'exact':'ls /system/bin/md5','stdout':'/system/bin/md5'},{'exact':'logcat -v long','hang':True}]}
  def shell(cmd,stdout=''): script['shell'].append({'exact':cmd,'stdout':stdout})
  device=script['devices'][0]
  if mode.startswith('video'):
   device['files']=[{'path':f'/sdcard/pkg.clazz-method-batch-{i}.mp4','file':'sample.mp4'} for i in range(2 if mode=='video-timeout' else 1)]
   script['shell'].append({'prefix':'screenrecord ','hang':True});shell('ps -A | grep screenrecord');
   for i in range(2 if mode=='video-timeout' else 1):shell(f'rm /sdcard/pkg.clazz-method-batch-{i}.mp4')
  elif mode=='screenshot':device['framebuffer']={'version':1,'file':'../../vendor-android/framebuffer/screencap_1.bin'}
  elif mode=='filesync-coverage':
   for name in ['screenshots','coverage']:
    path=('/sdcard/' if name=='screenshots' else '/data/local/tmp/')+name
    shell('rm -r '+path);shell('mkdir '+path)
   shell('run-as com.example rm -R /data/data/com.example/coverage');shell('run-as com.example mkdir /data/data/com.example/coverage');shell('ls -l /sdcard/screenshots')
   shell("mkdir -p /data/local/tmp/coverage && run-as com.example sh -c 'cd /data/data/com.example/coverage && tar cf - .' | tar xvf - -C /data/local/tmp/coverage && run-as com.example rm -R /data/data/com.example/coverage")
   shell('ls -l /data/local/tmp/coverage','-rw-r--r-- 1 shell shell 8 2024-01-01 12:00 coverage-batch.ec\n')
   device['files']=[{'path':'/data/local/tmp/coverage/coverage-batch.ec','content':'coverage'}]
  else:
   shell('pidof com.example','42\n');shell("echo 'pid: 42, pkg: com.example' | perfetto --txt -c - -o /data/misc/perfetto-traces/pkg.clazz-method-batch.perfetto-trace")
   shell('killall perfetto');shell('rm -f /data/misc/perfetto-traces/pkg.clazz-method-batch.perfetto-trace')
   device['files']=[{'path':'/data/misc/perfetto-traces/pkg.clazz-method-batch.perfetto-trace','content':'trace'}]
  script_path=base/(mode+'.json');script_path.write_text(json.dumps(script,indent=2)+'\n')
  port=temp/'port';transcript=temp/'transcript';log=open(temp/'server.log','w')
  server=subprocess.Popen([str(root/'target/debug/fake-adb'),'--script',str(script_path),'--port','0','--port-file',str(port),'--transcript',str(transcript),'--strict'],stdout=log,stderr=log)
  try:
   for _ in range(500):
    if port.exists():break
    if server.poll() is not None:raise RuntimeError((temp/'server.log').read_text())
    time.sleep(.01)
   assert port.read_text().strip()!='5037'
   env=dict(os.environ,PROBE_SOURCE='ScenarioProbe.kt',PROBE_MODE=mode,PROBE_PORT=port.read_text().strip(),PROBE_TRANSCRIPT=str(transcript),PROBE_OUTPUT=str(temp/'output'))
   result=subprocess.run(['python3',str(pathlib.Path(__file__).with_name('run'))],env=env,capture_output=True,text=True,timeout=60)
   if result.returncode:raise RuntimeError(result.stderr+'\n'+result.stdout[-1500:])
  finally:server.terminate();rc=server.wait(timeout=10);log.close()
  if rc:raise RuntimeError((temp/'server.log').read_text())
  rows=[json.loads(line) for line in transcript.read_text().splitlines()]
  assert not any(r.get('type')=='warning' for r in rows)
  (base/(mode+'-kotlin-transcript.jsonl')).write_text(transcript.read_text())
  observations=[json.loads(line) for line in result.stdout.splitlines() if line.startswith('{')]
  (base/(mode+'-kotlin.json')).write_text(json.dumps([r for r in observations if r['case'].startswith('scenario:')],indent=2)+'\n')
  for f in (temp/'output').rglob('*.gif'):
   (base/'screenshot-kotlin.gif').write_bytes(f.read_bytes())
  print(mode+': recorded',flush=True)
