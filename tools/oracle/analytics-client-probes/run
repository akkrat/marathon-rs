#!/usr/bin/env python3
"""Probe the frozen Kotlin classes and pinned clients against loopback peers."""
import os, subprocess, sys, tempfile, json, hashlib
from pathlib import Path
here = Path(__file__).resolve().parent
repo = here.parents[2]
lib = Path(os.environ.get('MARATHON_ORACLE_LIB', here.parent / 'build/marathon-src/cli/build/install/marathon/lib'))
if not lib.is_dir():
    sys.exit('Set MARATHON_ORACLE_LIB to an existing reference installDist lib directory')
cache = Path.home() / '.gradle/caches/modules-2/files-2.1'
def jar(g,a,v): return next((cache/g/a/v).glob('*/'+a+'-'+v+'.jar'))
compiler = [jar('org.jetbrains.kotlin','kotlin-compiler-embeddable','1.9.24'), jar('org.jetbrains.kotlin','kotlin-stdlib','1.9.24'), jar('org.jetbrains.kotlin','kotlin-script-runtime','1.9.24'), jar('org.jetbrains.kotlin','kotlin-reflect','1.6.10'), jar('org.jetbrains.intellij.deps','trove4j','1.0.20200330'), jar('org.jetbrains','annotations','13.0')]
java = str(Path(os.environ.get('JAVA_HOME','/Applications/Android Studio.app/Contents/jbr/Contents/Home'))/'bin/java')
cp = sorted(str(p) for p in lib.glob('*.jar'))
out = Path(sys.argv[1]) if len(sys.argv)>1 else repo/'fixtures/oracle/analytics-clients'
out.mkdir(parents=True,exist_ok=True)
with tempfile.TemporaryDirectory(prefix='analytics-clients-') as tmp:
    compiled = str(Path(tmp)/'probe.jar')
    compiled_result = subprocess.run([java,'-cp',os.pathsep.join(map(str,compiler)),'org.jetbrains.kotlin.cli.jvm.K2JVMCompiler','-no-stdlib','-no-reflect','-nowarn','-cp',os.pathsep.join(cp),'-d',compiled,str(here/'Clients.kt')])
    if compiled_result.returncode: sys.exit(compiled_result.returncode)
    result = subprocess.run([java,'-cp',os.pathsep.join([compiled]+cp),'ClientsKt',str(out)],timeout=300)
    if result.returncode: sys.exit(result.returncode)

versions = ['influxdb-java-2.24.jar','influxdb-client-java-7.2.0.jar','influxdb-client-core-7.2.0.jar','okhttp-4.12.0.jar']
metadata = {'reference':'e47352f2','jdk':subprocess.run([java,'-version'],capture_output=True,text=True,check=True).stderr.strip(),
            'jars':{name:hashlib.sha256((lib/name).read_bytes()).hexdigest() for name in versions},
            'generator_sha256':hashlib.sha256((here/'Clients.kt').read_bytes()).hexdigest(),
            'normalization':'Ephemeral loopback authorities in fault messages only; request paths, headers, payload bytes and response order unchanged.',
            'service_evidence':False}
(out/'metadata.json').write_text(json.dumps(metadata,indent=2)+'\n')
