#!/usr/bin/env python3
"""Capture pinned adam production requests against the strict scripted server, never host adb."""
from pathlib import Path
import os, subprocess, tempfile, time
root=Path(__file__).resolve().parents[3]
with tempfile.TemporaryDirectory(prefix='adam-request-fake-') as tmp:
    tmp=Path(tmp)
    proc=subprocess.Popen([str(root/'target/debug/fake-adb'),'--script',str(root/'fixtures/fake-adb/adb-requests/devices.yaml'),'--port','0','--port-file',str(tmp/'port'),'--transcript',str(tmp/'transcript.jsonl'),'--strict'],stdout=subprocess.DEVNULL)
    try:
        deadline=time.monotonic()+10
        while not (tmp/'port').exists():
            if proc.poll() is not None or time.monotonic()>deadline: raise RuntimeError('fake server failed to start')
            time.sleep(.01)
        env=dict(os.environ,MRS_REQUEST_FAKE_PORT=(tmp/'port').read_text().strip())
        subprocess.run([str(Path(__file__).with_name('run'))],env=env,check=True)
    finally:
        proc.terminate()
        rc=proc.wait(timeout=20)
    if rc: raise RuntimeError(f'strict server rc={rc}')
    (root/'fixtures/fake-adb/adb-requests/kotlin-transcript.jsonl').write_bytes((tmp/'transcript.jsonl').read_bytes())
