#!/usr/bin/env python3
"""Compile the actual frozen wrapper and focused probes against read-only installed jars."""
import os, pathlib, subprocess, sys, tempfile
here=pathlib.Path(__file__).resolve().parent
source=pathlib.Path(os.environ.get('MARATHON_KT',os.path.expanduser('~/src/marathon')))
lib=pathlib.Path(os.environ.get('MARATHON_KOTLIN_LIB',str(source/'cli/build/install/marathon/lib')))
cache=pathlib.Path.home()/'.gradle/caches/modules-2/files-2.1'
def jar(g,a,v): return next((cache/g/a/v).glob('*/*.jar'))
compiler=[jar('org.jetbrains.kotlin','kotlin-compiler-embeddable','1.9.24'),jar('org.jetbrains.kotlin','kotlin-stdlib','1.9.24'),jar('org.jetbrains.kotlin','kotlin-script-runtime','1.9.24'),jar('org.jetbrains.kotlin','kotlin-reflect','1.6.10'),jar('org.jetbrains.intellij.deps','trove4j','1.0.20200330'),jar('org.jetbrains','annotations','13.0')]
java=str(pathlib.Path(os.environ.get('JAVA_HOME','/Applications/Android Studio.app/Contents/jbr/Contents/Home'))/'bin/java')
cp=os.pathsep.join(map(str,lib.glob('*.jar')))
base=source/'vendor/vendor-apple/base/src/main/kotlin/com/malinskiy/marathon/apple'
files=[base/name for name in ['cmd/remote/rsync/RsyncTarget.kt','cmd/remote/rsync/RsyncFileBridge.kt','cmd/SharedTransfers.kt','cmd/WriteFile.kt','device/ConnectionFactory.kt','device/ConnectionFailures.kt','logparser/parser/DeviceFailureException.kt']]
with tempfile.TemporaryDirectory(prefix='mrs43-probe-') as tmp:
 out=pathlib.Path(tmp)/'classes'
 subprocess.run([java,'-cp',os.pathsep.join(map(str,compiler)),'org.jetbrains.kotlin.cli.jvm.K2JVMCompiler','-no-stdlib','-no-reflect','-nowarn','-jvm-target','17','-cp',cp,'-d',str(out),str(here/'Probe.kt'),*map(str,files)],check=True)
 try:
  subprocess.run([java,'-cp',str(out)+os.pathsep+cp,'ProbeKt',*sys.argv[1:]],check=True,timeout=5 if sys.argv[1]=='process-errors' else 60)
 except subprocess.TimeoutExpired:
  print('{"case":"jvm-cleanup","value":"watchdog-killed-after-5s"}',flush=True)
  print('Oracle JVM exceeded its post-method process-errors deadline; reader-thread leak retained as failed cleanup evidence.',file=sys.stderr)
  sys.exit(124)
