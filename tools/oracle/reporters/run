#!/usr/bin/env python3
"""Run WP 3.9c against read-only reference installDist jars, compiling in /tmp.
Usage: run <reference lib directory> [output directory]
"""
import hashlib, json, os, pathlib, subprocess, sys, tempfile
here = pathlib.Path(__file__).resolve().parent
lib = pathlib.Path(sys.argv[1]).resolve()
output = pathlib.Path(sys.argv[2]) if len(sys.argv)>2 else here.parents[2]/'fixtures/oracle/html-allure-gif'
cache = pathlib.Path.home()/'.gradle/caches/modules-2/files-2.1'
def jar(group, artifact, version):
    return next((cache/group/artifact/version).glob('*/'+artifact+'-'+version+'.jar'))
compiler = [jar('org.jetbrains.kotlin','kotlin-compiler-embeddable','1.9.24'),jar('org.jetbrains.kotlin','kotlin-stdlib','1.9.24'),jar('org.jetbrains.kotlin','kotlin-script-runtime','1.9.24'),jar('org.jetbrains.kotlin','kotlin-reflect','1.6.10'),jar('org.jetbrains.intellij.deps','trove4j','1.0.20200330'),jar('org.jetbrains','annotations','13.0')]
java = pathlib.Path(os.environ.get('JAVA_HOME','/Applications/Android Studio.app/Contents/jbr/Contents/Home'))/'bin/java'
cp = os.pathsep.join(str(p) for p in sorted(lib.glob('*.jar')))
output.mkdir(parents=True,exist_ok=True)
source = pathlib.Path(os.environ.get('MARATHON_KT',os.path.expanduser('~/src/marathon')))
sources = []
for directory in ['core/src/main/kotlin/com/malinskiy/marathon/report/html', 'core/src/main/kotlin/com/malinskiy/marathon/report/timeline', 'core/src/main/kotlin/com/malinskiy/marathon/report/allure', 'core/src/main/kotlin/com/malinskiy/marathon/device/screenshot', 'report/html-report/src/main/kotlin', 'report/execution-timeline/src/main/kotlin']:
    sources.extend(sorted((source/directory).rglob('*.kt')))
revision = subprocess.check_output(['git','-C',str(source),'rev-parse','HEAD'],text=True).strip()
if not revision.startswith('e47352f2'):
    sys.exit('oracle source must be e47352f2')
(output/'sources.sha256').write_text(''.join(hashlib.sha256(p.read_bytes()).hexdigest()+'  '+p.relative_to(source).as_posix()+'\n' for p in sources))
with tempfile.TemporaryDirectory(prefix='reporters-oracle-', dir='/tmp') as tmp:
    out = pathlib.Path(tmp)/'probes.jar'
    subprocess.run([str(java),'-cp',os.pathsep.join(map(str,compiler)),'org.jetbrains.kotlin.cli.jvm.K2JVMCompiler','-no-stdlib','-no-reflect','-jvm-target','17','-cp',cp,'-d',str(out),str(here/'ReporterProbes.kt'), *map(str, sources)],check=True)
    # environment-writer's success line goes to System.out; keep it as raw evidence.
    with open(output/'stdout.txt','wb') as stdout:
        subprocess.run([str(java),'-Duser.language=en','-Duser.country=US','-cp',str(out)+os.pathsep+cp,'ReporterProbesKt',str(output.resolve()),tmp],check=True,stdout=stdout)
(output/'jars.sha256').write_text(''.join(hashlib.sha256(p.read_bytes()).hexdigest()+'  '+p.name+'\n' for p in sorted(lib.glob('*.jar'))))
(output/'manifest.json').write_text(json.dumps([
    {'path':str(p.relative_to(output/'manifest')), 'kind':'directory' if p.is_dir() else 'file',
     **({} if p.is_dir() else {'sha256':hashlib.sha256(p.read_bytes()).hexdigest()})}
    for p in sorted((output/'manifest').rglob('*'))],indent=2)+'\n')
(output/'evidence.sha256').write_text(''.join(
    hashlib.sha256(p.read_bytes()).hexdigest()+'  '+p.relative_to(output).as_posix()+'\n'
    for p in sorted(output.rglob('*')) if p.is_file() and p.name!='evidence.sha256'))
