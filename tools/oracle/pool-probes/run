#!/usr/bin/env python3
"""Run the WP 3.8 pool probes against the reference installDist (tools/oracle/build.sh reference).

Usage: tools/oracle/pool-probes/run [OUT_DIR]   (default fixtures/oracle/pool)
Compiles PoolProbes.kt with the cached Kotlin 1.9.24 compiler against the distribution's lib/ jars.
"""
import os
import subprocess
import sys
import tempfile
from pathlib import Path

here = Path(__file__).resolve().parent
repo = here.parents[2]
lib = here.parent / 'build/marathon-src/cli/build/install/marathon/lib'
if not lib.is_dir():
    sys.exit(f'no reference distribution at {lib}; run tools/oracle/build.sh reference')
cache = Path.home() / '.gradle/caches/modules-2/files-2.1'
def jar(group, artifact, version):
    return next((cache / group / artifact / version).glob('*/' + artifact + '-' + version + '.jar'))

compiler = [jar('org.jetbrains.kotlin', 'kotlin-compiler-embeddable', '1.9.24'),
            jar('org.jetbrains.kotlin', 'kotlin-stdlib', '1.9.24'),
            jar('org.jetbrains.kotlin', 'kotlin-script-runtime', '1.9.24'),
            jar('org.jetbrains.kotlin', 'kotlin-reflect', '1.6.10'),
            jar('org.jetbrains.intellij.deps', 'trove4j', '1.0.20200330'),
            jar('org.jetbrains', 'annotations', '13.0')]
classpath = sorted(str(p) for p in lib.glob('*.jar'))
for group, artifact, version in [
 ('org.jetbrains.kotlinx','kotlinx-coroutines-test-jvm','1.8.1'),
 ('org.mockito.kotlin','mockito-kotlin','5.4.0'),
 ('org.mockito','mockito-core','5.12.0'),
 ('net.bytebuddy','byte-buddy','1.14.15'),
 ('net.bytebuddy','byte-buddy-agent','1.14.15'),
 ('org.objenesis','objenesis','3.3'),
]:
    classpath.append(str(jar(group,artifact,version)))
java = str(Path(os.environ.get('JAVA_HOME', '/Applications/Android Studio.app/Contents/jbr/Contents/Home')) / 'bin/java')
version = subprocess.run([java, '-version'], capture_output=True, text=True, check=True).stderr
if '21.0.10' not in version:
    sys.exit('pool probes require JBR 21.0.10')
if not (lib / 'kotlinx-coroutines-core-jvm-1.8.1.jar').is_file():
    sys.exit('pool probes require coroutines 1.8.1')
out_dir = Path(sys.argv[1]) if len(sys.argv) > 1 else repo / 'fixtures/oracle/pool'
with tempfile.TemporaryDirectory(prefix='pool-probes-') as tmp:
    out = str(Path(tmp) / 'probes.jar')
    def run(args, **kw):
        if subprocess.run(args, **kw).returncode:
            sys.exit(f'failed: {args[-1]}')
    sys.dont_write_bytecode = True
    from adapt import sources
    inputs = sources(Path(tmp))
    run([java, '-cp', os.pathsep.join(map(str, compiler)),
                    'org.jetbrains.kotlin.cli.jvm.K2JVMCompiler', '-no-stdlib', '-no-reflect', '-nowarn', '-jvm-target', '11',
                    '-cp', os.pathsep.join(classpath), '-d', out, str(here / 'PoolProbes.kt'), str(here / 'SchedulerProbes.kt'), *map(str, inputs)])
    # PoolProgressAccumulator prints progress lines to stdout; the rows go to files.
    run([java, '-cp', os.pathsep.join([out] + classpath), 'oracle.pool.PoolProbesKt', str(out_dir)], stdout=subprocess.DEVNULL)
