{
  "schema": 1,
  "name": "macos-smoke",
  "platform": "macos",
  "target": "AppleWorldTests",
  "tests": [
    {
      "class": "SmokeTests",
      "method": "testPass",
      "status": "passed"
    },
    {
      "class": "SmokeTests",
      "method": "testFail",
      "status": "failed"
    },
    {
      "class": "SmokeTests",
      "method": "testSkip",
      "status": "skipped"
    }
  ],
  "media": "none",
  "expectations": [
    {
      "name": "xcode-version",
      "matcher": {
        "exact": "xcrun xcodebuild -version"
      },
      "min": 1,
      "max": 1
    },
    {
      "name": "batch",
      "matcher": {
        "prefix": "xcrun xcodebuild test-without-building "
      },
      "min": 2,
      "max": 2
    },
    {
      "name": "enrichment-root",
      "matcher": {
        "pattern": "xcrun xcresulttool get --legacy --format json --path *"
      },
      "min": 2,
      "max": 2
    }
  ]
}
