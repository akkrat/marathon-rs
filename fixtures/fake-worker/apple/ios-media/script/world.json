{
  "schema": 1,
  "name": "ios-media",
  "platform": "ios",
  "target": "sample_appUITests",
  "tests": [
    {
      "class": "FailingTests",
      "method": "testAlwaysFailing",
      "status": "failed"
    }
  ],
  "media": "video",
  "expectations": [
    {
      "name": "xcode-version",
      "matcher": {
        "exact": "xcrun xcodebuild -version"
      },
      "min": 1,
      "max": 1
    },
    {
      "name": "batch",
      "matcher": {
        "prefix": "xcrun xcodebuild test-without-building "
      },
      "min": 1,
      "max": 1
    },
    {
      "name": "enrichment-root",
      "matcher": {
        "pattern": "xcrun xcresulttool get --legacy --format json --path *"
      },
      "min": 2,
      "max": 2
    },
    {
      "name": "boot",
      "matcher": {
        "exact": "xcrun simctl boot AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE"
      },
      "min": 1,
      "max": 1
    },
    {
      "name": "shutdown",
      "matcher": {
        "exact": "xcrun simctl shutdown AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE"
      },
      "min": 1,
      "max": 1
    },
    {
      "name": "recording",
      "matcher": {
        "prefix": "xcrun simctl io AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE recordVideo "
      },
      "min": 1,
      "max": 1
    },
    {
      "name": "device-log",
      "matcher": {
        "prefix": "xcrun simctl spawn AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE log stream "
      },
      "min": 1,
      "max": 1
    },
    {
      "name": "transcode",
      "matcher": {
        "prefix": "sh -c '/opt/homebrew/bin/ffmpeg -i "
      },
      "min": 1,
      "max": 1
    }
  ]
}
