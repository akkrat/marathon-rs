{
  "schema": 1,
  "name": "macos-parse",
  "platform": "macos",
  "target": "AppleWorldTests",
  "tests": [
    {
      "class": "SmokeTests",
      "method": "testPass",
      "status": "passed"
    },
    {
      "class": "SmokeTests",
      "method": "testFail",
      "status": "failed"
    },
    {
      "class": "SmokeTests",
      "method": "testSkip",
      "status": "skipped"
    }
  ],
  "media": "none",
  "expectations": [
    {
      "name": "xcode-version",
      "matcher": {
        "exact": "xcrun xcodebuild -version"
      },
      "min": 1,
      "max": 1
    }
  ],
  "line_delay_ms": 30,
  "parse_only": true
}
