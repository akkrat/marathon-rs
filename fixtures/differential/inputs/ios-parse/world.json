{
  "schema": 1,
  "name": "ios-parse",
  "platform": "ios",
  "target": "sample_appUnitTests",
  "tests": [
    {
      "class": "SampleTests",
      "method": "testPassing",
      "status": "passed"
    },
    {
      "class": "SampleTests",
      "method": "testFailing",
      "status": "failed"
    },
    {
      "class": "SampleTests",
      "method": "testSkipping",
      "status": "skipped"
    }
  ],
  "media": "none",
  "expectations": [
    {
      "name": "xcode-version",
      "matcher": {
        "exact": "xcrun xcodebuild -version"
      },
      "min": 1,
      "max": 1
    }
  ],
  "line_delay_ms": 30,
  "parse_only": true
}
